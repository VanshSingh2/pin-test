{
  "name": "🎬 YouTube + TikTok AI — Complete Automation (All-in-One)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "0 6 * * *" }] }
      },
      "id": "trg-gen", "name": "⏰ Content Gen (Daily 6AM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2, "position": [-200, 200]
    },
    {
      "parameters": {
        "assignments": { "assignments": [
          { "id": "c1", "name": "platform",     "value": "youtube", "type": "string" },
          { "id": "c2", "name": "videosPerRun", "value": 1,         "type": "number" },
          { "id": "c3", "name": "bufferDays",   "value": 3,         "type": "number" },
          { "id": "c4", "name": "niche",        "value": "motivational and self-improvement shorts for young women", "type": "string" },
          { "id": "c5", "name": "videoStyle",   "value": "faceless vertical short, cinematic b-roll, bold captions", "type": "string" },
          { "id": "c6", "name": "scheduleHour", "value": 14,        "type": "number" },
          { "id": "c7", "name": "enabled",      "value": true,      "type": "boolean" }
        ]}
      },
      "id": "ctrl", "name": "⚙️ CONTROL PANEL",
      "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [20, 200],
      "notes": "TOGGLE:\nplatform = 'youtube' | 'tiktok' | 'both'\nvideosPerRun = videos created per run\nbufferDays = skip generating if this many already queued\nenabled = master on/off"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [{ "id": "en", "leftValue": "={{ $json.enabled }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equal" } }],
          "combinator": "and"
        }
      },
      "id": "if-en", "name": "❓ Enabled?",
      "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [240, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/video_queue?status=in.(idea,rendering,ready)&select=id",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "apikey",        "value": "={{ $vars.SUPABASE_SERVICE_KEY }}" },
          { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_KEY }}" }
        ]},
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "sb-buffer", "name": "💾 Supabase: Buffer Check",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [460, 200]
    },
    {
      "parameters": {
        "jsCode": "const cfg=$('⚙️ CONTROL PANEL').first().json;\nconst rows=Array.isArray($input.first().json)?$input.first().json:($input.first().json.data||[]);\nconst queued=rows.length;\nconst need=(cfg.bufferDays||3)*(cfg.videosPerRun||1);\nconst generate = queued < need;\nconsole.log(`queued=${queued} need=${need} generate=${generate}`);\nreturn [{ json:{ ...cfg, queued, need, generate } }];"
      },
      "id": "buf-dec", "name": "🧠 Buffer Decision",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [680, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [{ "id": "gn", "leftValue": "={{ $json.generate }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equal" } }],
          "combinator": "and"
        }
      },
      "id": "if-gen", "name": "❓ Need Content?",
      "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [900, 200]
    },
    {
      "parameters": {
        "jsCode": "const cfg=$('🧠 Buffer Decision').first().json;\nconst now=new Date();\nconst months=['January','February','March','April','May','June','July','August','September','October','November','December'];\nconst sys=`You are a YouTube + TikTok content strategist (Agent 1: Content Strategy). Niche: ${cfg.niche}. Find a fresh, high-retention SHORT-FORM video topic for ${months[now.getMonth()]} ${now.getFullYear()}. Return ONLY valid JSON.`;\nconst usr=`Propose 1 trending short-form video idea.\\nReturn JSON: {\\\"topic\\\":\\\"specific topic\\\",\\\"hook\\\":\\\"3-second opening hook line\\\",\\\"angle\\\":\\\"why it will retain viewers\\\"}`;\nreturn [{ json:{ ...cfg, requestBody:{ model:'gpt-4o-mini', messages:[{role:'system',content:sys},{role:'user',content:usr}], temperature:0.9, max_tokens:400 } } }];"
      },
      "id": "build-strat", "name": "🧭 Agent1: Build Strategy",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1120, 120]
    },
    {
      "parameters": {
        "method": "POST", "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Authorization", "value": "=Bearer {{ $vars.OPENAI_API_KEY }}" },
          { "name": "Content-Type",  "value": "application/json" }
        ]},
        "sendBody": true, "contentType": "raw", "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.requestBody) }}", "options": {}
      },
      "id": "ai-strat", "name": "🤖 OpenAI: Topic Strategy",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1340, 120]
    },
    {
      "parameters": {
        "jsCode": "const cfg=$('🧭 Agent1: Build Strategy').first().json;\nconst raw=$input.first().json.choices[0].message.content;\nlet t={}; try{t=JSON.parse(raw);}catch(e){const m=raw.match(/\\{[\\s\\S]*\\}/);if(m)t=JSON.parse(m[0]);}\nconst sys='You are a short-form video scriptwriter (Agent 2: Script Writer). Write a tight, punchy 30-45 second narration script with a strong hook and clear payoff. Return ONLY valid JSON.';\nconst usr=`Topic: ${t.topic}\\nHook: ${t.hook}\\nStyle: ${cfg.videoStyle}\\nReturn JSON: {\\\"script\\\":\\\"full narration, 90-130 words, no scene labels\\\",\\\"caption_lines\\\":[\\\"short on-screen caption 1\\\",\\\"caption 2\\\",\\\"caption 3\\\",\\\"caption 4\\\"]}`;\nreturn [{ json:{ ...cfg, topic:t.topic, hook:t.hook, requestBody:{ model:'gpt-4o-mini', messages:[{role:'system',content:sys},{role:'user',content:usr}], temperature:0.85, max_tokens:700 } } }];"
      },
      "id": "build-script", "name": "✍️ Agent2: Build Script",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1560, 120]
    },
    {
      "parameters": {
        "method": "POST", "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Authorization", "value": "=Bearer {{ $vars.OPENAI_API_KEY }}" },
          { "name": "Content-Type",  "value": "application/json" }
        ]},
        "sendBody": true, "contentType": "raw", "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.requestBody) }}", "options": {}
      },
      "id": "ai-script", "name": "🤖 OpenAI: Write Script",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1780, 120]
    },
    {
      "parameters": {
        "jsCode": "const cfg=$('✍️ Agent2: Build Script').first().json;\nconst raw=$input.first().json.choices[0].message.content;\nlet s={}; try{s=JSON.parse(raw);}catch(e){const m=raw.match(/\\{[\\s\\S]*\\}/);if(m)s=JSON.parse(m[0]);}\nconst sys='You are a YouTube/TikTok SEO optimizer (Agent 4: SEO). Return ONLY valid JSON.';\nconst usr=`Topic: ${cfg.topic}\\nReturn JSON: {\\\"title\\\":\\\"clickable title max 70 chars\\\",\\\"description\\\":\\\"2-3 sentence description with keywords and CTA\\\",\\\"tags\\\":\\\"12 comma-separated keywords\\\",\\\"hashtags\\\":\\\"8 space-separated #tags for Shorts/TikTok\\\"}`;\nreturn [{ json:{ ...cfg, script:s.script||'', caption_lines:s.caption_lines||[], requestBody:{ model:'gpt-4o-mini', messages:[{role:'system',content:sys},{role:'user',content:usr}], temperature:0.7, max_tokens:500 } } }];"
      },
      "id": "build-seo", "name": "🔍 Agent4: Build SEO",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2000, 120]
    },
    {
      "parameters": {
        "method": "POST", "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Authorization", "value": "=Bearer {{ $vars.OPENAI_API_KEY }}" },
          { "name": "Content-Type",  "value": "application/json" }
        ]},
        "sendBody": true, "contentType": "raw", "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.requestBody) }}", "options": {}
      },
      "id": "ai-seo", "name": "🤖 OpenAI: SEO Pack",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [2220, 120]
    },
    {
      "parameters": {
        "jsCode": "const cfg=$('🔍 Agent4: Build SEO').first().json;\nconst raw=$input.first().json.choices[0].message.content;\nlet o={}; try{o=JSON.parse(raw);}catch(e){const m=raw.match(/\\{[\\s\\S]*\\}/);if(m)o=JSON.parse(m[0]);}\nconst thumbPrompt=`YouTube thumbnail for a short about \"${cfg.topic}\". Bold, high-contrast, emotional facial expression or striking visual, vibrant colors, cinematic, no text. Vertical 9:16 friendly.`;\nreturn [{ json:{ ...cfg, title:(o.title||cfg.topic||'').slice(0,95), description:o.description||'', tags:o.tags||'', hashtags:o.hashtags||'', dalleBody:{ model:'dall-e-3', prompt:thumbPrompt, n:1, size:'1024x1792', quality:'standard', response_format:'url' } } }];"
      },
      "id": "build-thumb", "name": "🎨 Agent3: Build Thumbnail",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2440, 120]
    },
    {
      "parameters": {
        "method": "POST", "url": "https://api.openai.com/v1/images/generations",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Authorization", "value": "=Bearer {{ $vars.OPENAI_API_KEY }}" },
          { "name": "Content-Type",  "value": "application/json" }
        ]},
        "sendBody": true, "contentType": "raw", "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.dalleBody) }}",
        "options": { "timeout": 60000, "response": { "response": { "neverError": true } } }
      },
      "id": "dalle", "name": "🎨 DALL-E: Thumbnail",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [2660, 120]
    },
    {
      "parameters": {
        "jsCode": "const cfg=$('🎨 Agent3: Build Thumbnail').first().json;\nconst resp=$input.first().json;\nlet url=''; try{url=resp.data[0].url;}catch(e){}\nreturn [{ json:{ ...cfg, rawThumbUrl:url } }];"
      },
      "id": "thumb-url", "name": "📋 Get Thumb URL",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2880, 120]
    },
    {
      "parameters": {
        "method": "POST", "url": "https://api.imgbb.com/1/upload",
        "sendBody": true, "contentType": "form-urlencoded",
        "bodyParameters": { "parameters": [
          { "name": "key",   "value": "={{ $vars.IMGBB_API_KEY }}" },
          { "name": "image", "value": "={{ $json.rawThumbUrl }}" }
        ]},
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "imgbb", "name": "☁️ Imgbb: Host Thumbnail",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [3100, 120]
    },

    {
      "parameters": {
        "jsCode": "const cfg=$('🎨 Agent3: Build Thumbnail').first().json;\nconst resp=$input.first().json;\nlet hosted=''; try{hosted=resp.data.url||resp.data.display_url;}catch(e){}\nconst bg=hosted||cfg.rawThumbUrl;\nconst caps=(cfg.caption_lines&&cfg.caption_lines.length?cfg.caption_lines:[cfg.title]);\n// Build a JSON2Video movie: vertical 9:16, background image + TTS voice from script + caption text\nconst movie={\n  resolution:'instagram-story',\n  quality:'high',\n  scenes:[{\n    comment:'main',\n    duration:-1,\n    elements:[\n      { type:'image', src:bg, zoom:2, duration:-1 },\n      { type:'voice', text:cfg.script, voice:'en-US-AriaNeural' },\n      { type:'subtitles', settings:{ style:'boxed-word', 'font-size':64, position:'center' } }\n    ]\n  }]\n};\nreturn [{ json:{ ...cfg, thumbnail_url:bg, json2videoBody:movie } }];"
      },
      "id": "build-render", "name": "🎬 Agent5: Build Render Job",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [3320, 120]
    },
    {
      "parameters": {
        "method": "POST", "url": "https://api.json2video.com/v2/movies",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "x-api-key",     "value": "={{ $vars.JSON2VIDEO_API_KEY }}" },
          { "name": "Content-Type",  "value": "application/json" }
        ]},
        "sendBody": true, "contentType": "raw", "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.json2videoBody) }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "json2video", "name": "🎞️ JSON2Video: Submit Render",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [3540, 120]
    },
    {
      "parameters": {
        "jsCode": "const cfg=$('🎬 Agent5: Build Render Job').first().json;\nconst resp=$input.first().json;\nconst renderId = resp.project || (resp.movie&&resp.movie.project) || resp.id || null;\n// schedule each new video scheduleHour today (or next slot); offset by existing buffer\nconst now=new Date();\nconst sched=new Date(now);\nsched.setHours(cfg.scheduleHour||14,0,0,0);\nif(sched<=now) sched.setDate(sched.getDate()+1);\n// push out by number already queued so they don't all post same time\nsched.setDate(sched.getDate()+ (cfg.queued||0));\nreturn [{ json:{\n  platform:cfg.platform, niche:cfg.niche, topic:cfg.topic, hook:cfg.hook,\n  script:cfg.script, title:cfg.title, description:cfg.description,\n  tags:cfg.tags, hashtags:cfg.hashtags, thumbnail_url:cfg.thumbnail_url,\n  render_id:renderId, status: renderId?'rendering':'failed',\n  scheduled_time:sched.toISOString(),\n  error_notes: renderId?null:('Render submit failed: '+JSON.stringify(resp).slice(0,200))\n}}];"
      },
      "id": "queue-row", "name": "📦 Build Queue Row",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [3760, 120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/video_queue",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "apikey",        "value": "={{ $vars.SUPABASE_SERVICE_KEY }}" },
          { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_KEY }}" },
          { "name": "Content-Type",  "value": "application/json" },
          { "name": "Prefer",        "value": "return=minimal" }
        ]},
        "sendBody": true, "contentType": "raw", "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json) }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "sb-insert-video", "name": "💾 Supabase: Insert Video",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [3980, 120]
    },
    {
      "parameters": {},
      "id": "skip-gen", "name": "⏭️ Skip (buffer full / disabled)",
      "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [1120, 320]
    },

    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "*/15 * * * *" }] }
      },
      "id": "trg-pub", "name": "⏰ Publish Queue (15min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2, "position": [-200, 700]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/video_queue?status=eq.rendering&select=id,render_id&limit=20",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "apikey",        "value": "={{ $vars.SUPABASE_SERVICE_KEY }}" },
          { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_KEY }}" }
        ]},
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "sb-get-render", "name": "💾 Supabase: Get Rendering",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [20, 600]
    },
    {
      "parameters": { "fieldToSplitOut": "data", "options": {} },
      "id": "split-render", "name": "📋 Split Rendering",
      "type": "n8n-nodes-base.splitOut", "typeVersion": 1, "position": [240, 600]
    },
    {
      "parameters": { "batchSize": 1, "options": {} },
      "id": "loop-render", "name": "🔄 Check Each Render",
      "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [460, 600]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.json2video.com/v2/movies?project={{ $json.render_id }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "x-api-key", "value": "={{ $vars.JSON2VIDEO_API_KEY }}" }
        ]},
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "j2v-status", "name": "🎞️ JSON2Video: Status",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [680, 600]
    },
    {
      "parameters": {
        "jsCode": "const row=$('🔄 Check Each Render').first().json;\nconst resp=$input.first().json;\nconst movie=resp.movie||resp;\nconst done = movie.status==='done' && movie.url;\nreturn [{ json:{ id:row.id, ready:done, video_url: done?movie.url:null } }];"
      },
      "id": "render-check", "name": "📋 Render Done?",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [900, 600]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [{ "id": "rd", "leftValue": "={{ $json.ready }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equal" } }],
          "combinator": "and"
        }
      },
      "id": "if-ready", "name": "❓ Ready?",
      "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1120, 600]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/video_queue?id=eq.{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "apikey",        "value": "={{ $vars.SUPABASE_SERVICE_KEY }}" },
          { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_KEY }}" },
          { "name": "Content-Type",  "value": "application/json" },
          { "name": "Prefer",        "value": "return=minimal" }
        ]},
        "sendBody": true, "contentType": "raw", "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ status:'ready', video_url:$json.video_url }) }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "sb-mark-ready", "name": "💾 Supabase: Mark Ready",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1340, 520]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/video_queue?status=eq.ready&scheduled_time=lte.{{ $now.toISO() }}&select=*&limit=5",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "apikey",        "value": "={{ $vars.SUPABASE_SERVICE_KEY }}" },
          { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_KEY }}" }
        ]},
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "sb-get-due", "name": "💾 Supabase: Get Due Videos",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [20, 850]
    },
    {
      "parameters": { "fieldToSplitOut": "data", "options": {} },
      "id": "split-due", "name": "📋 Split Due",
      "type": "n8n-nodes-base.splitOut", "typeVersion": 1, "position": [240, 850]
    },
    {
      "parameters": { "batchSize": 1, "options": {} },
      "id": "loop-pub", "name": "🔄 Publish Each",
      "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [460, 850]
    },
    {
      "parameters": {
        "rules": { "values": [
          { "conditions": { "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" }, "conditions": [{ "id": "yt", "leftValue": "={{ $json.platform }}", "rightValue": "youtube", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "outputKey": "youtube" },
          { "conditions": { "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" }, "conditions": [{ "id": "tt", "leftValue": "={{ $json.platform }}", "rightValue": "tiktok", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "outputKey": "tiktok" },
          { "conditions": { "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" }, "conditions": [{ "id": "bo", "leftValue": "={{ $json.platform }}", "rightValue": "both", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "outputKey": "both" }
        ]},
        "options": {}
      },
      "id": "switch-plat", "name": "🔀 TOGGLE: Platform",
      "type": "n8n-nodes-base.switch", "typeVersion": 3, "position": [680, 850]
    },
    {
      "parameters": {
        "url": "={{ $json.video_url }}",
        "options": { "response": { "response": { "responseFormat": "file" } } }
      },
      "id": "dl-video", "name": "⬇️ Download Video",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [900, 740]
    },
    {
      "parameters": {
        "resource": "video", "operation": "upload",
        "title": "={{ $('🔄 Publish Each').item.json.title }}",
        "regionCode": "US",
        "categoryId": "22",
        "options": {
          "description": "={{ $('🔄 Publish Each').item.json.description }}\n\n{{ $('🔄 Publish Each').item.json.hashtags }}",
          "privacyStatus": "public",
          "tags": "={{ ($('🔄 Publish Each').item.json.tags||'').split(',') }}"
        },
        "binaryProperty": "data"
      },
      "id": "yt-upload", "name": "▶️ YouTube: Upload",
      "type": "n8n-nodes-base.youTube", "typeVersion": 1, "position": [1120, 740],
      "credentials": { "youTubeOAuth2Api": { "id": "YT_CRED_ID", "name": "YouTube OAuth2" } }
    },
    {
