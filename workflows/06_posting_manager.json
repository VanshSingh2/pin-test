{
  "name": "📮 Pinterest AI — 06 Posting Manager",
  "nodes": [
    {
      "parameters": {},
      "id": "pm-001", "name": "📥 Called by Orchestrator",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1, "position": [200, 300]
    },
    {
      "parameters": {
        "authentication": "oAuth2", "operation": "read",
        "documentId": { "__rl": true, "value": "={{ $vars.GOOGLE_SHEET_ID }}", "mode": "expression" },
        "sheetName":  { "__rl": true, "value": "Content_Queue", "mode": "name" },
        "filtersUI": { "values": [{ "lookupColumn": "status", "lookupValue": "ready_to_post" }] },
        "returnAllMatches": true, "options": { "limit": 2 }
      },
      "id": "pm-002", "name": "📑 Read Ready to Post",
      "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.5, "position": [420, 300],
      "credentials": { "googleSheetsOAuth2Api": { "id": "GSHEETS_CRED_ID", "name": "Google Sheets OAuth" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [{ "id": "c1", "leftValue": "={{ $input.all().filter(i=>i.json.id).length }}", "rightValue": 0, "operator": { "type": "number", "operation": "gt" } }],
          "combinator": "and"
        }
      },
      "id": "pm-003", "name": "❓ Has Items to Post?",
      "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [640, 300]
    },
    {
      "parameters": { "batchSize": 1, "options": {} },
      "id": "pm-004", "name": "🔄 Post One by One",
      "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [860, 160]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst boardId = item.board_id || $vars.PINTEREST_BOARD_ID_LIFESTYLE || '';\n\nconst pinterestBody = {\n  board_id:    boardId,\n  title:       item.pin_title,\n  description: item.pin_description + '\\n\\n' + (item.hashtags || ''),\n  media_source: {\n    source_type: 'image_url',\n    url:         item.image_url\n  },\n  link: item.link_url || ''\n};\n\nreturn [{ json: { ...item, pinterestBody, boardId } }];"
      },
      "id": "pm-005", "name": "📝 Build Pinterest Request",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1080, 160]
    },
    {
      "parameters": {
        "method": "POST", "url": "https://api.pinterest.com/v5/pins",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Authorization", "value": "=Bearer {{ $vars.PINTEREST_ACCESS_TOKEN }}" },
          { "name": "Content-Type",  "value": "application/json" }
        ]},
        "sendBody": true, "contentType": "raw", "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.pinterestBody) }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "pm-006", "name": "📌 Pinterest: Create Pin",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1300, 160]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [{ "id": "c2", "leftValue": "={{ $json.id ? true : false }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equal" } }],
          "combinator": "and"
        }
      },
      "id": "pm-007", "name": "❓ Pinterest Success?",
      "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1520, 160]
    },
    {
      "parameters": {
        "jsCode": "const pinterestResp = $input.first().json;\nconst originalItem  = $('📝 Build Pinterest Request').first().json;\n\nreturn [{ json: {\n  id:          originalItem.id,\n  pin_id:      pinterestResp.id,\n  platform:    'pinterest',\n  status:      'posted',\n  posted_at:   new Date().toISOString()\n}}];"
      },
      "id": "pm-008", "name": "📋 Prep Pinterest Success",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1740, 60]
    },
    {
      "parameters": {
        "authentication": "oAuth2", "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "value": "={{ $vars.GOOGLE_SHEET_ID }}", "mode": "expression" },
        "sheetName":  { "__rl": true, "value": "Content_Queue", "mode": "name" },
        "columns": { "mappingMode": "autoMapInputData", "value": {}, "matchingColumns": ["id"], "schema": [] },
        "options": {}
      },
      "id": "pm-009", "name": "✅ Mark Posted (Pinterest)",
      "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.5, "position": [1960, 60],
      "credentials": { "googleSheetsOAuth2Api": { "id": "GSHEETS_CRED_ID", "name": "Google Sheets OAuth" } }
    },
    {
      "parameters": {
        "jsCode": "const originalItem = $('📝 Build Pinterest Request').first().json;\n\nconst bufferBody = {\n  profile_ids: [$vars.BUFFER_PROFILE_ID || ''],\n  text: originalItem.pin_title + '\\n\\n' + originalItem.pin_description + '\\n\\n' + (originalItem.hashtags || ''),\n  media: { photo: originalItem.image_url, thumbnail: originalItem.image_url },\n  shorten: false,\n  now: true\n};\n\nreturn [{ json: { ...originalItem, bufferBody } }];"
      },
      "id": "pm-010", "name": "📝 Build Buffer Request",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1740, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.bufferapp.com/1/updates/create.json?access_token={{ $vars.BUFFER_ACCESS_TOKEN }}",
        "sendBody": true, "contentType": "form-urlencoded",
        "bodyParameters": { "parameters": [
          { "name": "profile_ids[]", "value": "={{ $vars.BUFFER_PROFILE_ID }}" },
          { "name": "text",          "value": "={{ $json.pin_title + '\\n\\n' + $json.pin_description + '\\n\\n' + ($json.hashtags || '') }}" },
          { "name": "media[photo]",  "value": "={{ $json.image_url }}" },
          { "name": "now",           "value": "true" }
        ]},
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "pm-011", "name": "📱 Buffer: Schedule Post",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1960, 260]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [{ "id": "c3", "leftValue": "={{ $json.success || ($json.updates && $json.updates.length > 0) ? true : false }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equal" } }],
          "combinator": "and"
        }
      },
      "id": "pm-012", "name": "❓ Buffer Success?",
      "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [2180, 260]
    },
    {
      "parameters": {
        "jsCode": "const bufferResp   = $input.first().json;\nconst originalItem = $('📝 Build Buffer Request').first().json;\nconst updateId     = bufferResp.updates ? bufferResp.updates[0].id : 'buffer_ok';\n\nreturn [{ json: {\n  id:        originalItem.id,\n  pin_id:    updateId,\n  platform:  'buffer',\n  status:    'posted_buffer',\n  posted_at: new Date().toISOString()\n}}];"
      },
      "id": "pm-013", "name": "📋 Prep Buffer Success",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2400, 160]
    },
    {
      "parameters": {
        "authentication": "oAuth2", "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "value": "={{ $vars.GOOGLE_SHEET_ID }}", "mode": "expression" },
        "sheetName":  { "__rl": true, "value": "Content_Queue", "mode": "name" },
        "columns": { "mappingMode": "autoMapInputData", "value": {}, "matchingColumns": ["id"], "schema": [] },
        "options": {}
      },
      "id": "pm-014", "name": "✅ Mark Posted (Buffer)",
      "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.5, "position": [2620, 160],
      "credentials": { "googleSheetsOAuth2Api": { "id": "GSHEETS_CRED_ID", "name": "Google Sheets OAuth" } }
    },
    {
      "parameters": {
        "jsCode": "const originalItem = $('📝 Build Buffer Request').first().json;\nreturn [{ json: {\n  id:          originalItem.id,\n  status:      'failed',\n  error_notes: 'Both Pinterest and Buffer posting failed at ' + new Date().toISOString()\n}}];"
      },
      "id": "pm-015", "name": "📋 Prep Failed Status",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2400, 360]
    },
    {
      "parameters": {
        "authentication": "oAuth2", "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "value": "={{ $vars.GOOGLE_SHEET_ID }}", "mode": "expression" },
        "sheetName":  { "__rl": true, "value": "Content_Queue", "mode": "name" },
        "columns": { "mappingMode": "autoMapInputData", "value": {}, "matchingColumns": ["id"], "schema": [] },
        "options": {}
      },
      "id": "pm-016", "name": "❌ Mark as Failed",
      "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.5, "position": [2620, 360],
      "credentials": { "googleSheetsOAuth2Api": { "id": "GSHEETS_CRED_ID", "name": "Google Sheets OAuth" } }
    },
    {
      "parameters": {},
      "id": "pm-017", "name": "⏭️ Skip No Items",
      "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [860, 440]
    },
    {
      "parameters": { "mode": "passThrough", "output": "input1" },
      "id": "pm-018", "name": "🔀 Merge Post Results",
      "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [2840, 260]
    },
    {
      "parameters": {},
      "id": "pm-019", "name": "🔄 Next Item",
      "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [3060, 260]
    },
    {
      "parameters": { "mode": "passThrough", "output": "input1" },
      "id": "pm-020", "name": "🔀 Final Merge",
      "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [3280, 300]
    },
    {
      "parameters": { "assignments": { "assignments": [
        { "id": "a1", "name": "agent",  "value": "Posting Manager", "type": "string" },
        { "id": "a2", "name": "status", "value": "done",            "type": "string" }
      ]}},
      "id": "pm-021", "name": "✅ Done",
      "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [3500, 300]
    }
  ],
  "connections": {
    "📥 Called by Orchestrator":  { "main": [[{ "node": "📑 Read Ready to Post",        "type": "main", "index": 0 }]] },
    "📑 Read Ready to Post":      { "main": [[{ "node": "❓ Has Items to Post?",         "type": "main", "index": 0 }]] },
    "❓ Has Items to Post?": { "main": [
      [{ "node": "🔄 Post One by One", "type": "main", "index": 0 }],
      [{ "node": "⏭️ Skip No Items",  "type": "main", "index": 0 }]
    ]},
    "🔄 Post One by One":         { "main": [[{ "node": "📝 Build Pinterest Request",   "type": "main", "index": 0 }]] },
    "📝 Build Pinterest Request": { "main": [[{ "node": "📌 Pinterest: Create Pin",     "type": "main", "index": 0 }]] },
    "📌 Pinterest: Create Pin":   { "main": [[{ "node": "❓ Pinterest Success?",        "type": "main", "index": 0 }]] },
    "❓ Pinterest Success?": { "main": [
      [{ "node": "📋 Prep Pinterest Success", "type": "main", "index": 0 }],
      [{ "node": "📝 Build Buffer Request",   "type": "main", "index": 0 }]
    ]},
    "📋 Prep Pinterest Success":  { "main": [[{ "node": "✅ Mark Posted (Pinterest)",   "type": "main", "index": 0 }]] },
    "✅ Mark Posted (Pinterest)": { "main": [[{ "node": "🔀 Merge Post Results",        "type": "main", "index": 0 }]] },
    "📝 Build Buffer Request":    { "main": [[{ "node": "📱 Buffer: Schedule Post",     "type": "main", "index": 0 }]] },
    "📱 Buffer: Schedule Post":   { "main": [[{ "node": "❓ Buffer Success?",           "type": "main", "index": 0 }]] },
    "❓ Buffer Success?": { "main": [
      [{ "node": "📋 Prep Buffer Success",  "type": "main", "index": 0 }],
      [{ "node": "📋 Prep Failed Status",   "type": "main", "index": 0 }]
    ]},
    "📋 Prep Buffer Success":     { "main": [[{ "node": "✅ Mark Posted (Buffer)",      "type": "main", "index": 0 }]] },
    "✅ Mark Posted (Buffer)":    { "main": [[{ "node": "🔀 Merge Post Results",        "type": "main", "index": 1 }]] },
    "📋 Prep Failed Status":      { "main": [[{ "node": "❌ Mark as Failed",            "type": "main", "index": 0 }]] },
    "❌ Mark as Failed":          { "main": [[{ "node": "🔀 Merge Post Results",        "type": "main", "index": 1 }]] },
    "🔀 Merge Post Results":      { "main": [[{ "node": "🔄 Next Item",                 "type": "main", "index": 0 }]] },
    "🔄 Next Item":               { "main": [[{ "node": "🔄 Post One by One",           "type": "main", "index": 0 }]] },
    "⏭️ Skip No Items":          { "main": [[{ "node": "🔀 Final Merge",               "type": "main", "index": 1 }]] },
    "🔀 Final Merge":             { "main": [[{ "node": "✅ Done",                      "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "id": "wf-06-posting-manager",
  "tags": [{ "id": "pinterest-ai", "name": "Pinterest AI" }]
}
