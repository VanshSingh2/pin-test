{
  "name": "📊 Pinterest AI — 07 Analytics Tracker",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "0 9 * * *" }] }
      },
      "id": "at-001", "name": "⏰ Daily at 9 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2, "position": [200, 300]
    },
    {
      "parameters": {
        "authentication": "oAuth2", "operation": "read",
        "documentId": { "__rl": true, "value": "={{ $vars.GOOGLE_SHEET_ID }}", "mode": "expression" },
        "sheetName":  { "__rl": true, "value": "Content_Queue", "mode": "name" },
        "filtersUI": { "values": [{ "lookupColumn": "status", "lookupValue": "posted" }] },
        "returnAllMatches": true, "options": { "limit": 50 }
      },
      "id": "at-002", "name": "📑 Read Posted Pins",
      "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.5, "position": [420, 300],
      "credentials": { "googleSheetsOAuth2Api": { "id": "GSHEETS_CRED_ID", "name": "Google Sheets OAuth" } }
    },
    {
      "parameters": {
        "jsCode": "const pins = $input.all().filter(i => i.json.pin_id && i.json.platform === 'pinterest');\nconsole.log(`Found ${pins.length} Pinterest pins to fetch analytics for`);\nif (pins.length === 0) return [{ json: { _noPins: true } }];\nreturn pins;"
      },
      "id": "at-003", "name": "🔍 Filter Pinterest Pins",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [640, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [{ "id": "c1", "leftValue": "={{ $json._noPins }}", "rightValue": true, "operator": { "type": "boolean", "operation": "notEqual" } }],
          "combinator": "and"
        }
      },
      "id": "at-004", "name": "❓ Has Pinterest Pins?",
      "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [860, 300]
    },
    {
      "parameters": { "batchSize": 1, "options": {} },
      "id": "at-005", "name": "🔄 Check Each Pin",
      "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [1080, 160]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.pinterest.com/v5/pins/{{ $json.pin_id }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Authorization", "value": "=Bearer {{ $vars.PINTEREST_ACCESS_TOKEN }}" }
        ]},
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "at-006", "name": "📊 Pinterest: Get Pin Data",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1300, 160]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.pinterest.com/v5/pins/{{ $('🔄 Check Each Pin').first().json.pin_id }}/analytics?start_date={{ $now.minus({days:7}).toFormat('yyyy-MM-dd') }}&end_date={{ $now.toFormat('yyyy-MM-dd') }}&metric_types=IMPRESSION,SAVE,PIN_CLICK,OUTBOUND_CLICK",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Authorization", "value": "=Bearer {{ $vars.PINTEREST_ACCESS_TOKEN }}" }
        ]},
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "at-007", "name": "📊 Pinterest: Get Analytics",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1300, 320]
    },
    {
      "parameters": {
        "jsCode": "const pinData       = $('📊 Pinterest: Get Pin Data').first().json;\nconst analyticsData = $input.first().json;\nconst originalPin   = $('🔄 Check Each Pin').first().json;\n\n// Extract metrics from analytics response\nlet impressions = 0, saves = 0, clicks = 0, outbound = 0;\ntry {\n  const allMetrics = analyticsData.all || {};\n  const daily      = allMetrics.daily_metrics || [];\n  daily.forEach(day => {\n    impressions += (day.metrics && day.metrics.IMPRESSION)      || 0;\n    saves       += (day.metrics && day.metrics.SAVE)           || 0;\n    clicks      += (day.metrics && day.metrics.PIN_CLICK)      || 0;\n    outbound    += (day.metrics && day.metrics.OUTBOUND_CLICK)  || 0;\n  });\n} catch(e) { console.log('Analytics parse error:', e.message); }\n\nconst saveRate  = impressions > 0 ? ((saves / impressions) * 100).toFixed(2) : '0';\nconst clickRate = impressions > 0 ? ((clicks / impressions) * 100).toFixed(2) : '0';\n\nreturn [{ json: {\n  date:           new Date().toISOString().split('T')[0],\n  pin_id:         originalPin.pin_id,\n  pin_title:      originalPin.pin_title || '',\n  impressions:    impressions.toString(),\n  saves:          saves.toString(),\n  clicks:         clicks.toString(),\n  outbound_clicks:outbound.toString(),\n  save_rate:      saveRate,\n  click_rate:     clickRate\n}}];"
      },
      "id": "at-008", "name": "📋 Process Analytics",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1520, 240]
    },
    {
      "parameters": {
        "authentication": "oAuth2", "operation": "append",
        "documentId": { "__rl": true, "value": "={{ $vars.GOOGLE_SHEET_ID }}", "mode": "expression" },
        "sheetName":  { "__rl": true, "value": "Analytics", "mode": "name" },
        "columns": { "mappingMode": "autoMapInputData", "value": {}, "matchingColumns": [], "schema": [] },
        "options": {}
      },
      "id": "at-009", "name": "💾 Save to Analytics Sheet",
      "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.5, "position": [1740, 240],
      "credentials": { "googleSheetsOAuth2Api": { "id": "GSHEETS_CRED_ID", "name": "Google Sheets OAuth" } }
    },
    {
      "parameters": {},
      "id": "at-010", "name": "⏭️ Skip No Pins",
      "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [1080, 440]
    },
    {
      "parameters": { "mode": "passThrough", "output": "input1" },
      "id": "at-011", "name": "🔀 Final Merge",
      "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [1960, 300]
    },
    {
      "parameters": {
        "jsCode": "const analyticsRows = $('💾 Save to Analytics Sheet').all();\nconst totalImpres = analyticsRows.reduce((s,i) => s + Number(i.json.impressions||0), 0);\nconst totalSaves  = analyticsRows.reduce((s,i) => s + Number(i.json.saves||0),       0);\n\nreturn [{ json: {\n  agent:           'Analytics Tracker',\n  status:          'done',\n  pinsAnalysed:    analyticsRows.length,\n  totalImpressions:totalImpres,\n  totalSaves:      totalSaves,\n  completedAt:     new Date().toISOString()\n}}];"
      },
      "id": "at-012", "name": "✅ Summary",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2180, 300]
    }
  ],
  "connections": {
    "⏰ Daily at 9 AM":             { "main": [[{ "node": "📑 Read Posted Pins",        "type": "main", "index": 0 }]] },
    "📑 Read Posted Pins":          { "main": [[{ "node": "🔍 Filter Pinterest Pins",   "type": "main", "index": 0 }]] },
    "🔍 Filter Pinterest Pins":     { "main": [[{ "node": "❓ Has Pinterest Pins?",     "type": "main", "index": 0 }]] },
    "❓ Has Pinterest Pins?": { "main": [
      [{ "node": "🔄 Check Each Pin", "type": "main", "index": 0 }],
      [{ "node": "⏭️ Skip No Pins",  "type": "main", "index": 0 }]
    ]},
    "🔄 Check Each Pin":            { "main": [[{ "node": "📊 Pinterest: Get Pin Data", "type": "main", "index": 0 },
                                                { "node": "📊 Pinterest: Get Analytics","type": "main", "index": 0 }]] },
    "📊 Pinterest: Get Analytics":  { "main": [[{ "node": "📋 Process Analytics",      "type": "main", "index": 0 }]] },
    "📋 Process Analytics":         { "main": [[{ "node": "💾 Save to Analytics Sheet", "type": "main", "index": 0 }]] },
    "💾 Save to Analytics Sheet":   { "main": [[{ "node": "🔄 Check Each Pin",          "type": "main", "index": 0 }]] },
    "⏭️ Skip No Pins":             { "main": [[{ "node": "🔀 Final Merge",              "type": "main", "index": 1 }]] },
    "🔀 Final Merge":               { "main": [[{ "node": "✅ Summary",                 "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "id": "wf-07-analytics-tracker",
  "tags": [{ "id": "pinterest-ai", "name": "Pinterest AI" }]
}
