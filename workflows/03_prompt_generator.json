{
  "name": "✍️ Pinterest AI — 03 Prompt Generator",
  "nodes": [
    {
      "parameters": {},
      "id": "pg-001", "name": "📥 Called by Orchestrator",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1, "position": [200, 300]
    },
    {
      "parameters": {
        "authentication": "oAuth2", "operation": "read",
        "documentId": { "__rl": true, "value": "={{ $vars.GOOGLE_SHEET_ID }}", "mode": "expression" },
        "sheetName":  { "__rl": true, "value": "Content_Queue", "mode": "name" },
        "filtersUI": { "values": [{ "lookupColumn": "status", "lookupValue": "new_idea" }] },
        "returnAllMatches": true, "options": { "limit": 10 }
      },
      "id": "pg-002", "name": "📑 Read New Ideas",
      "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.5, "position": [420, 300],
      "credentials": { "googleSheetsOAuth2Api": { "id": "GSHEETS_CRED_ID", "name": "Google Sheets OAuth" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [{ "id": "c1", "leftValue": "={{ $input.all().filter(i => i.json.id).length }}", "rightValue": 0, "operator": { "type": "number", "operation": "gt" } }],
          "combinator": "and"
        }
      },
      "id": "pg-003", "name": "❓ Has Ideas to Process?",
      "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [640, 300]
    },
    {
      "parameters": { "batchSize": 1, "options": {} },
      "id": "pg-004", "name": "🔄 One by One",
      "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [860, 160]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst systemPrompt = 'You are a professional AI image prompt engineer specializing in Pinterest-aesthetic visuals for girls and women. Create prompts that produce beautiful, feminine, scroll-stopping images. Return ONLY the prompt text, nothing else.';\n\nconst userPrompt = `Write a DALL-E 3 image generation prompt for a Pinterest pin about: \"${item.title_idea}\"\\nCategory: ${item.category}, Type: ${item.content_type}\\n\\nRequirements:\\n- Portrait orientation (best for Pinterest: 2:3 ratio)\\n- Aesthetic, feminine visual style\\n- Soft, dreamy color palette (pastels, rose gold, cream, sage green, blush pink)\\n- No text or words in the image\\n- Photorealistic or digital art style\\n- High quality, magazine-worthy composition\\n- Natural lighting, cozy atmosphere\\n\\nReturn only the image prompt, no explanation.`;\n\nreturn [{ json: {\n  ...item,\n  requestBody: { model:'gpt-4o-mini', messages:[\n    { role:'system', content: systemPrompt },\n    { role:'user',   content: userPrompt }\n  ], temperature: 0.8, max_tokens: 300 }\n}}];"
      },
      "id": "pg-005", "name": "📝 Build Prompt Request",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1080, 160]
    },
    {
      "parameters": {
        "method": "POST", "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Authorization", "value": "=Bearer {{ $vars.OPENAI_API_KEY }}" },
          { "name": "Content-Type",  "value": "application/json" }
        ]},
        "sendBody": true, "contentType": "raw", "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.requestBody) }}",
        "options": {}
      },
      "id": "pg-006", "name": "🤖 OpenAI: Create Image Prompt",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1300, 160]
    },
    {
      "parameters": {
        "jsCode": "const response  = $input.first().json;\nconst prevItem  = $('📝 Build Prompt Request').first().json;\nconst prompt    = response.choices[0].message.content.trim();\n\nreturn [{ json: {\n  id:           prevItem.id,\n  image_prompt: prompt,\n  status:       'has_prompt'\n}}];"
      },
      "id": "pg-007", "name": "📋 Extract Prompt",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1520, 160]
    },
    {
      "parameters": {
        "authentication": "oAuth2", "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "value": "={{ $vars.GOOGLE_SHEET_ID }}", "mode": "expression" },
        "sheetName":  { "__rl": true, "value": "Content_Queue", "mode": "name" },
        "columns": { "mappingMode": "autoMapInputData", "value": {}, "matchingColumns": ["id"], "schema": [] },
        "options": {}
      },
      "id": "pg-008", "name": "💾 Update Row with Prompt",
      "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.5, "position": [1740, 160],
      "credentials": { "googleSheetsOAuth2Api": { "id": "GSHEETS_CRED_ID", "name": "Google Sheets OAuth" } }
    },
    {
      "parameters": {},
      "id": "pg-009", "name": "⏭️ Skip No Ideas",
      "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [860, 440]
    },
    {
      "parameters": { "mode": "passThrough", "output": "input1" },
      "id": "pg-010", "name": "🔀 Final Merge",
      "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [1960, 300]
    },
    {
      "parameters": { "assignments": { "assignments": [
        { "id": "a1", "name": "agent",  "value": "Prompt Generator", "type": "string" },
        { "id": "a2", "name": "status", "value": "done",             "type": "string" }
      ]}},
      "id": "pg-011", "name": "✅ Done",
      "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [2180, 300]
    }
  ],
  "connections": {
    "📥 Called by Orchestrator":   { "main": [[{ "node": "📑 Read New Ideas",            "type": "main", "index": 0 }]] },
    "📑 Read New Ideas":           { "main": [[{ "node": "❓ Has Ideas to Process?",     "type": "main", "index": 0 }]] },
    "❓ Has Ideas to Process?": { "main": [
      [{ "node": "🔄 One by One",    "type": "main", "index": 0 }],
      [{ "node": "⏭️ Skip No Ideas", "type": "main", "index": 0 }]
    ]},
    "🔄 One by One":               { "main": [[{ "node": "📝 Build Prompt Request",      "type": "main", "index": 0 }]] },
    "📝 Build Prompt Request":     { "main": [[{ "node": "🤖 OpenAI: Create Image Prompt","type": "main", "index": 0 }]] },
    "🤖 OpenAI: Create Image Prompt":{ "main": [[{ "node": "📋 Extract Prompt",          "type": "main", "index": 0 }]] },
    "📋 Extract Prompt":           { "main": [[{ "node": "💾 Update Row with Prompt",    "type": "main", "index": 0 }]] },
    "💾 Update Row with Prompt":   { "main": [[{ "node": "🔄 One by One",               "type": "main", "index": 0 }]] },
    "⏭️ Skip No Ideas":           { "main": [[{ "node": "🔀 Final Merge",              "type": "main", "index": 1 }]] },
    "🔀 Final Merge":              { "main": [[{ "node": "✅ Done",                     "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "id": "wf-03-prompt-generator",
  "tags": [{ "id": "pinterest-ai", "name": "Pinterest AI" }]
}
