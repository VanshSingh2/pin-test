{
  "name": "📌 Pinterest AI v2 — Smart Conversational (Telegram)",
  "nodes": [
    {
      "parameters": { "updates": ["message"], "additionalFields": {} },
      "id": "pn-trigger", "name": "💬 Telegram Command",
      "type": "n8n-nodes-base.telegramTrigger", "typeVersion": 1.2, "position": [-600, 400],
      "credentials": { "telegramApi": { "id": "TG_CRED_ID", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "jsCode": "const msg=$input.first().json.message||{};\nreturn [{ json:{ chatId:String((msg.chat&&msg.chat.id)||''), text:(msg.text||'').trim() } }];"
      },
      "id": "pn-intake", "name": "🧠 Intake",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-380, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/pin_state?chat_id=eq.{{ $json.chatId }}&select=*",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_KEY }}" },
          { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_KEY }}" }
        ]},
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "pn-load", "name": "💾 Load Chat State",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-160, 400]
    },
    {
      "parameters": {
        "jsCode": "const intake=$('🧠 Intake').first().json;\nconst rows=Array.isArray($input.first().json)?$input.first().json:($input.first().json.data||[]);\nconst s=rows[0]||{ niche:'', style:'', board_id:'', pending_action:null };\nconst pending=s.pending_action||null;\nconst sys=`You are the expert Pinterest manager for a creator. Chat naturally and CONFIRM before creating pins.\\n\\nCurrent settings:\\n- niche: \\\"${s.niche||'(not set)'}\\\"\\n- visual style: \\\"${s.style||'(not set)'}\\\"\\n- pending action: ${pending?JSON.stringify(pending):'(none)'}\\n\\nRules:\\n- Setting niche/style => intent=set_config, fill set_niche/set_style.\\n- Asking to CREATE pin(s) => intent=propose, action_type=pin, fill topic and count (default 1). Reply with the plan and ask them to reply 'yes'.\\n- Confirmation with a pending action => intent=confirm.\\n- cancel => intent=cancel. Else intent=chat.\\n- If niche/style missing when creating, ask to set first (intent=chat).\\nRespond STRICT JSON only.`;\nconst usr=`User: \\\"${intake.text}\\\"\\nReturn JSON: {\\n \\\"reply\\\":\\\"...\\\",\\n \\\"intent\\\":\\\"set_config|propose|confirm|cancel|chat\\\",\\n \\\"set_niche\\\":\\\"\\\",\\\"set_style\\\":\\\"\\\",\\n \\\"action_type\\\":\\\"pin|none\\\",\\\"topic\\\":\\\"\\\",\\\"count\\\":1\\n}`;\nreturn [{ json:{ chatId:intake.chatId, niche:s.niche||'', style:s.style||'', board_id:s.board_id||'', pending, requestBody:{ model:($vars.OPENROUTER_LLM_MODEL||'openai/gpt-4o'), response_format:{type:'json_object'}, messages:[{role:'system',content:sys},{role:'user',content:usr}], temperature:0.5, max_tokens:600 } } }];"
      },
      "id": "pn-brain-build", "name": "🧠 Manager Brain Prompt",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [60, 400]
    },
    {
      "parameters": {
        "method": "POST", "url": "https://openrouter.ai/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Authorization", "value": "=Bearer {{ $vars.OPENROUTER_API_KEY }}" },
          { "name": "Content-Type", "value": "application/json" }
        ]},
        "sendBody": true, "contentType": "raw", "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.requestBody) }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "pn-brain-ai", "name": "🤖 OpenRouter: Manager",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [280, 400]
    },
    {
      "parameters": {
        "jsCode": "const ctx=$('🧠 Manager Brain Prompt').first().json;\nlet o={};try{o=JSON.parse($input.first().json.choices[0].message.content);}catch(e){const mm=((($input.first().json.choices||[{}])[0].message||{}).content||'').match(/\\{[\\s\\S]*\\}/);if(mm)o=JSON.parse(mm[0]);}\nconst p=ctx.pending||{};\nconst action_type=(o.action_type&&o.action_type!=='none')?o.action_type:(p.action_type||'pin');\nreturn [{ json:{ chatId:ctx.chatId, niche:ctx.niche, style:ctx.style, board_id:ctx.board_id, reply:o.reply||'Okay!', intent:o.intent||'chat', set_niche:o.set_niche||'', set_style:o.set_style||'', action_type, topic:o.topic||p.topic||'', count:Number(o.count||p.count||1) } }];"
      },
      "id": "pn-brain-parse", "name": "📋 Parse Manager",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [500, 400]
    },
    {
      "parameters": {
        "rules": { "values": [
          { "conditions": { "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" }, "conditions": [{ "id": "sc", "leftValue": "={{ $json.intent }}", "rightValue": "set_config", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "outputKey": "set_config" },
          { "conditions": { "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" }, "conditions": [{ "id": "pr", "leftValue": "={{ $json.intent }}", "rightValue": "propose", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "outputKey": "propose" },
          { "conditions": { "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" }, "conditions": [{ "id": "cf", "leftValue": "={{ $json.intent }}", "rightValue": "confirm", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "outputKey": "confirm" },
          { "conditions": { "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" }, "conditions": [{ "id": "cn", "leftValue": "={{ $json.intent }}", "rightValue": "cancel", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "outputKey": "cancel" }
        ]}, "options": { "fallbackOutput": "extra" }
      },
      "id": "pn-route", "name": "🔀 Route Intent",
      "type": "n8n-nodes-base.switch", "typeVersion": 3, "position": [720, 400]
    },
    {
      "parameters": {
        "method": "POST", "url": "={{ $vars.SUPABASE_URL }}/rest/v1/pin_state?on_conflict=chat_id",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_KEY }}" },
          { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_KEY }}" },
          { "name": "Content-Type", "value": "application/json" },
          { "name": "Prefer", "value": "resolution=merge-duplicates" }
        ]},
        "sendBody": true, "contentType": "raw", "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ chat_id:$json.chatId, niche:($json.set_niche||$json.niche||''), style:($json.set_style||$json.style||''), updated_at:$now.toISO() }) }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "pn-save-config", "name": "💾 Save Settings",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [980, 140]
    },
    {
      "parameters": {
        "chatId": "={{ $('📋 Parse Manager').first().json.chatId }}",
        "text": "={{ $('📋 Parse Manager').first().json.reply }}",
        "additionalFields": {}
      },
      "id": "pn-reply-config", "name": "💬 Reply: Config",
      "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [1200, 140],
      "credentials": { "telegramApi": { "id": "TG_CRED_ID", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "method": "POST", "url": "={{ $vars.SUPABASE_URL }}/rest/v1/pin_state?on_conflict=chat_id",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_KEY }}" },
          { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_KEY }}" },
          { "name": "Content-Type", "value": "application/json" },
          { "name": "Prefer", "value": "resolution=merge-duplicates" }
        ]},
        "sendBody": true, "contentType": "raw", "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ chat_id:$json.chatId, pending_action:{ action_type:$json.action_type, topic:$json.topic, count:$json.count }, updated_at:$now.toISO() }) }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "pn-save-pending", "name": "💾 Save Pending",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [980, 320]
    },
    {
      "parameters": {
        "chatId": "={{ $('📋 Parse Manager').first().json.chatId }}",
        "text": "={{ $('📋 Parse Manager').first().json.reply }}",
        "additionalFields": {}
      },
      "id": "pn-reply-propose", "name": "💬 Reply: Proposal",
      "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [1200, 320],
      "credentials": { "telegramApi": { "id": "TG_CRED_ID", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "method": "POST", "url": "={{ $vars.SUPABASE_URL }}/rest/v1/pin_state?on_conflict=chat_id",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_KEY }}" },
          { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_KEY }}" },
          { "name": "Content-Type", "value": "application/json" },
          { "name": "Prefer", "value": "resolution=merge-duplicates" }
        ]},
        "sendBody": true, "contentType": "raw", "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ chat_id:$json.chatId, pending_action:null, updated_at:$now.toISO() }) }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "pn-clear-pending", "name": "💾 Clear Pending",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [980, 500]
    },
    {
      "parameters": {
        "chatId": "={{ $('📋 Parse Manager').first().json.chatId }}",
        "text": "={{ $('📋 Parse Manager').first().json.reply }}",
        "additionalFields": {}
      },
      "id": "pn-reply-cancel", "name": "💬 Reply: Cancelled",
      "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [1200, 500],
      "credentials": { "telegramApi": { "id": "TG_CRED_ID", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "chatId": "={{ $('📋 Parse Manager').first().json.chatId }}",
        "text": "={{ $('📋 Parse Manager').first().json.reply }}",
        "additionalFields": {}
      },
      "id": "pn-reply-chat", "name": "💬 Reply: Chat",
      "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [980, 680],
      "credentials": { "telegramApi": { "id": "TG_CRED_ID", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "jsCode": "const m=$json;\nconst sys=`You are a Pinterest SEO + design expert for the niche \\\"${m.niche}\\\", visual style \\\"${m.style}\\\". Respond STRICT JSON only.`;\nconst usr=`Topic: ${m.topic}\\nReturn JSON: {\\\"image_prompt\\\":\\\"vivid vertical 2:3 pin image, no text in image\\\",\\\"pin_title\\\":\\\"<=100 chars keyword-rich\\\",\\\"pin_description\\\":\\\"<=500 chars with keywords + CTA\\\",\\\"hashtags\\\":\\\"6 space-separated #tags\\\"}`;\nreturn [{ json:{ chatId:m.chatId, niche:m.niche, style:m.style, board_id:m.board_id, topic:m.topic, job:'pin2_'+Date.now(), requestBody:{ model:($vars.OPENROUTER_LLM_MODEL||'openai/gpt-4o'), response_format:{type:'json_object'}, messages:[{role:'system',content:sys},{role:'user',content:usr}], temperature:0.8, max_tokens:700 } } }];"
      },
      "id": "pn-plan", "name": "🧩 Pin: Plan",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [980, 860]
    },
    {
      "parameters": {
        "method": "POST", "url": "https://openrouter.ai/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Authorization", "value": "=Bearer {{ $vars.OPENROUTER_API_KEY }}" },
          { "name": "Content-Type", "value": "application/json" }
        ]},
        "sendBody": true, "contentType": "raw", "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.requestBody) }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "pn-plan-ai", "name": "🤖 OpenRouter: Pin Plan",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1200, 860]
    },
    {
      "parameters": {
        "jsCode": "const m=$('🧩 Pin: Plan').first().json;\nlet o={};try{o=JSON.parse($input.first().json.choices[0].message.content);}catch(e){const mm=((($input.first().json.choices||[{}])[0].message||{}).content||'').match(/\\{[\\s\\S]*\\}/);if(mm)o=JSON.parse(mm[0]);}\nreturn [{ json:{ ...m, image_prompt:o.image_prompt||m.topic, pin_title:(o.pin_title||m.topic||'').slice(0,100), pin_description:(o.pin_description||'').slice(0,500), hashtags:o.hashtags||'', imgReqBody:{ model:($vars.OPENROUTER_IMAGE_MODEL||'openai/gpt-image-1'), modalities:['image','text'], messages:[{ role:'user', content:('Vertical 2:3 Pinterest pin image, no text in the image. Visual style: '+m.style+'. '+(o.image_prompt||m.topic)) }] } } }];"
      },
      "id": "pn-parse", "name": "📋 Pin: Parse",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1420, 860]
    },
    {
      "parameters": {
        "method": "POST", "url": "https://openrouter.ai/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Authorization", "value": "=Bearer {{ $vars.OPENROUTER_API_KEY }}" },
          { "name": "Content-Type", "value": "application/json" }
        ]},
        "sendBody": true, "contentType": "raw", "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.imgReqBody) }}",
        "options": { "timeout": 120000, "response": { "response": { "neverError": true } } }
      },
      "id": "pn-img", "name": "🎨 OpenRouter: Pin Image",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1640, 860]
    },
    {
      "parameters": {
        "jsCode": "const base=$('📋 Pin: Parse').first().json;\nconst resp=$json;let b64='';\ntry{ const msg=resp.choices&&resp.choices[0]&&resp.choices[0].message; if(msg&&msg.images&&msg.images[0]){ const u=msg.images[0].image_url?msg.images[0].image_url.url:msg.images[0].url; b64=(u||'').split(',').pop(); } else if(resp.data&&resp.data[0]&&resp.data[0].b64_json){ b64=resp.data[0].b64_json; } }catch(e){}\nreturn [{ json:{ ...base, img_b64:b64 } }];"
      },
      "id": "pn-extract", "name": "🖼️ Extract Image",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1860, 860]
    },
    {
      "parameters": {
        "method": "POST", "url": "https://api.imgbb.com/1/upload",
        "sendBody": true, "contentType": "form-urlencoded",
        "bodyParameters": { "parameters": [
          { "name": "key", "value": "={{ $vars.IMGBB_API_KEY }}" },
          { "name": "image", "value": "={{ $json.img_b64 }}" }
        ]},
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "pn-host", "name": "☁️ Imgbb: Host Pin Image",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [2080, 860]
    },
    {
      "parameters": {
        "jsCode": "const base=$('📋 Pin: Parse').first().json;\nlet url='';try{url=$json.data.display_url||$json.data.url;}catch(e){}\nconst board=base.board_id||$vars.PINTEREST_BOARD_ID_LIFESTYLE||'';\nconst pinterestBody={ board_id:board, title:base.pin_title, description:(base.pin_description+'\\n\\n'+(base.hashtags||'')), media_source:{ source_type:'image_url', url } };\nreturn [{ json:{ chatId:base.chatId, niche:base.niche, style:base.style, topic:base.topic, image_url:url, pin_title:base.pin_title, pinterestBody } }];"
      },
      "id": "pn-build", "name": "📦 Pin: Build Post",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2300, 860]
    },
    {
      "parameters": {
        "method": "POST", "url": "https://api.pinterest.com/v5/pins",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Authorization", "value": "=Bearer {{ $vars.PINTEREST_ACCESS_TOKEN }}" },
          { "name": "Content-Type", "value": "application/json" }
        ]},
        "sendBody": true, "contentType": "raw", "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.pinterestBody) }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "pn-post", "name": "📌 Pinterest: Create Pin",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [2520, 860]
    },
    {
      "parameters": {
        "chatId": "={{ $('📦 Pin: Build Post').first().json.chatId }}",
        "text": "=✅ *Pin created!*\n📌 {{ $('📦 Pin: Build Post').first().json.niche }} · {{ $('📦 Pin: Build Post').first().json.style }}\n🖼️ {{ $('📦 Pin: Build Post').first().json.image_url }}\n📝 {{ $('📦 Pin: Build Post').first().json.pin_title }}\n\n{{ ($json.id ? ('Pinterest pin id: ' + $json.id) : 'Sent to Pinterest API (Trial pins are private until Standard access).') }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "pn-notify", "name": "💬 Telegram: Pin Done",
      "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [2740, 860],
      "credentials": { "telegramApi": { "id": "TG_CRED_ID", "name": "Telegram Bot" } }
    }
